<?xml version="1.0" encoding="UTF-8"?>
<system-design name="Weather Advisory Notification System" version="1.0">

  <!-- ═══════════════════════════════════════════════
       PIPELINE A — Admin Upload & Geo Ingestion
  ════════════════════════════════════════════════ -->
  <pipeline id="pipeline-a" name="Admin Upload and Geo Ingestion">

    <layer id="upload-layer" name="Upload Layer">
      <component id="admin-portal" type="ui" color="gray">
        <label>Admin portal</label>
        <description>Upload weekly weather advisory file</description>
        <accepts>PDF, Excel, JSON</accepts>
        <outputs-to ref="file-parser"/>
      </component>

      <component id="file-parser" type="service" color="teal">
        <label>File parser</label>
        <description>Extracts structured records from uploaded file</description>
        <supports-formats>
          <format>PDF</format>
          <format>Excel (.xlsx)</format>
          <format>JSON</format>
        </supports-formats>
        <outputs-to ref="schema-validator"/>
      </component>

      <component id="schema-validator" type="service" color="teal">
        <label>Schema validator</label>
        <description>Validates required fields before processing</description>
        <required-fields>
          <field>location_name</field>
          <field>from_date</field>
          <field>to_date</field>
          <field>advisory_body</field>
        </required-fields>
        <on-success outputs-to ref="geo-resolver"/>
        <on-failure action="reject-and-notify-admin"/>
      </component>
    </layer>

    <layer id="geo-enrichment-layer" name="Geo Enrichment Layer">
      <component id="location-string" type="data" color="gray">
        <label>Location string</label>
        <description>Raw location text extracted from file</description>
        <example>Nashik, Maharashtra</example>
        <outputs-to ref="nominatim-api"/>
      </component>

      <component id="nominatim-api" type="external-api" color="purple">
        <label>Nominatim API</label>
        <description>OpenStreetMap geocoding service</description>
        <base-url>https://nominatim.openstreetmap.org</base-url>
        <endpoint>/search?q={location}&amp;format=json&amp;addressdetails=1</endpoint>
        <returns>
          <field>district</field>
          <field>subdistrict</field>
          <field>state</field>
          <field>lat</field>
          <field>lon</field>
          <field>geo_code</field>
        </returns>
        <outputs-to ref="geo-resolver"/>
      </component>

      <component id="geo-resolver" type="service" color="purple">
        <label>Geo resolver</label>
        <description>Combines Nominatim response with advisory record</description>
        <resolves>
          <field>district</field>
          <field>subdistrict</field>
          <field>lat</field>
          <field>lon</field>
          <field>geo_code</field>
        </resolves>
        <outputs-to ref="record-enrichment"/>
      </component>
    </layer>

    <layer id="processing-layer" name="Processing Layer">
      <component id="record-enrichment" type="service" color="teal">
        <label>Record enrichment</label>
        <description>Merges geo data with advisory content into one record</description>
        <outputs-to ref="expiry-tagger"/>
      </component>

      <component id="expiry-tagger" type="service" color="teal">
        <label>Expiry tagger</label>
        <description>Stamps each record with active or expired status based on current date</description>
        <logic>
          <rule>if today >= from_date AND today &lt;= to_date then status = active</rule>
          <rule>if today > to_date then status = expired</rule>
        </logic>
        <outputs-to ref="advisories-table"/>
        <outputs-to ref="location-geo-table"/>
        <outputs-to ref="notification-events-table"/>
        <on-complete action="emit-event-to-bus"/>
      </component>
    </layer>

    <layer id="storage-layer-a" name="Storage Layer">
      <component id="advisories-table" type="database-table" color="blue">
        <label>advisories</label>
        <fields>
          <field name="id" type="uuid" key="primary"/>
          <field name="title" type="varchar"/>
          <field name="body" type="text"/>
          <field name="type" type="varchar"/>
          <field name="from_date" type="date"/>
          <field name="to_date" type="date"/>
          <field name="status" type="enum" values="active,expired"/>
          <field name="geo_code" type="varchar" key="foreign" ref="location-geo-table"/>
          <field name="created_at" type="timestamp"/>
        </fields>
      </component>

      <component id="location-geo-table" type="database-table" color="blue">
        <label>location_geo</label>
        <fields>
          <field name="id" type="uuid" key="primary"/>
          <field name="state" type="varchar"/>
          <field name="district" type="varchar"/>
          <field name="subdistrict" type="varchar"/>
          <field name="lat" type="decimal"/>
          <field name="lon" type="decimal"/>
          <field name="geo_code" type="varchar" key="unique"/>
        </fields>
      </component>

      <component id="notification-events-table" type="database-table" color="blue">
        <label>notification_events</label>
        <fields>
          <field name="id" type="uuid" key="primary"/>
          <field name="type" type="enum" values="weather_advisory,feature_launch,maintenance,system_alert"/>
          <field name="payload" type="jsonb"/>
          <field name="target_geo" type="varchar" nullable="true"/>
          <field name="is_published" type="boolean" default="false"/>
          <field name="created_at" type="timestamp"/>
        </fields>
      </component>
    </layer>

  </pipeline>


  <!-- ═══════════════════════════════════════════════
       PIPELINE B — Generic Notification Service
  ════════════════════════════════════════════════ -->
  <pipeline id="pipeline-b" name="Generic Notification Service and User Delivery">

    <layer id="producers-layer" name="Event Producers Layer">
      <component id="producer-weather" type="producer" color="teal">
        <label>Weather ingestion</label>
        <description>Emits event after advisory is saved to DB</description>
        <event-type>weather_advisory</event-type>
        <trigger>On successful expiry-tagger completion in Pipeline A</trigger>
        <outputs-to ref="message-bus"/>
      </component>

      <component id="producer-admin" type="producer" color="purple">
        <label>Admin console</label>
        <description>Admin manually creates and publishes notifications</description>
        <event-type>feature_launch</event-type>
        <trigger>Admin clicks publish in console</trigger>
        <outputs-to ref="message-bus"/>
      </component>

      <component id="producer-system" type="producer" color="gray">
        <label>System / cron</label>
        <description>Scheduled or automated system events</description>
        <event-types>
          <event-type>maintenance</event-type>
          <event-type>system_alert</event-type>
        </event-types>
        <trigger>Scheduled job or system condition</trigger>
        <outputs-to ref="message-bus"/>
      </component>
    </layer>

    <layer id="bus-layer" name="Message Bus Layer">
      <component id="message-bus" type="message-bus" color="amber">
        <label>Message bus</label>
        <description>Decouples producers from consumers</description>
        <technology options="Kafka, Redis Pub-Sub"/>
        <event-schema>
          <field name="event_id" type="uuid"/>
          <field name="type" type="string"/>
          <field name="payload" type="json"/>
          <field name="target_geo" type="string" nullable="true">
            <note>null means broadcast to all users</note>
          </field>
          <field name="published_at" type="timestamp"/>
        </event-schema>
        <outputs-to ref="event-consumer"/>
      </component>
    </layer>

    <layer id="notification-service-layer" name="Notification Service Layer">
      <component id="event-consumer" type="service" color="coral">
        <label>Event consumer</label>
        <description>Subscribes to all bus topics and routes by event type</description>
        <outputs-to ref="geo-expiry-check"/>
      </component>

      <component id="geo-expiry-check" type="service" color="coral">
        <label>Geo and expiry check</label>
        <description>Core validation before delivery</description>
        <validations>
          <rule id="location-match">User geo_code must match event target_geo at state/district/subdistrict level</rule>
          <rule id="expiry-check">today >= from_date AND today &lt;= to_date</rule>
          <rule id="broadcast-check">If target_geo is null, skip location match — send to all users</rule>
        </validations>
        <inputs-from ref="user-location-resolver"/>
        <on-pass outputs-to ref="notification-writer"/>
        <on-fail action="discard-silently"/>
      </component>

      <component id="user-location-resolver" type="service" color="blue">
        <label>User location resolver</label>
        <description>Resolves current user location to a geo_code</description>
        <resolution-methods>
          <method priority="1">Device GPS</method>
          <method priority="2">IP geolocation</method>
          <method priority="3">Saved profile location</method>
        </resolution-methods>
        <outputs-to ref="geo-expiry-check"/>
      </component>

      <component id="notification-writer" type="service" color="coral">
        <label>Notification writer</label>
        <description>Persists a notification record per eligible user</description>
        <outputs-to ref="user-notifications-table"/>
      </component>
    </layer>

    <layer id="storage-layer-b" name="Storage Layer">
      <component id="user-notifications-table" type="database-table" color="gray">
        <label>user_notifications</label>
        <fields>
          <field name="id" type="uuid" key="primary"/>
          <field name="user_id" type="uuid" key="foreign"/>
          <field name="event_id" type="uuid" key="foreign" ref="notification-events-table"/>
          <field name="is_read" type="boolean" default="false"/>
          <field name="delivered_at" type="timestamp"/>
          <field name="read_at" type="timestamp" nullable="true"/>
        </fields>
        <outputs-to ref="bell-icon"/>
      </component>
    </layer>

    <layer id="delivery-layer" name="Delivery Layer — Chatbot UI">
      <component id="bell-icon" type="ui" color="amber">
        <label>Bell icon</label>
        <description>Shows unread notification count badge</description>
        <polling-strategy>WebSocket preferred, HTTP polling fallback</polling-strategy>
        <badge-count-source ref="user-notifications-table" filter="is_read=false"/>
        <outputs-to ref="notification-panel"/>
      </component>

      <component id="notification-panel" type="ui" color="blue">
        <label>Notification panel</label>
        <description>Dropdown listing all notifications grouped by type</description>
        <features>
          <feature>Group by event type</feature>
          <feature>Mark individual as read</feature>
          <feature>Mark all as read</feature>
          <feature>Dismiss / delete</feature>
        </features>
        <outputs-to ref="detail-view"/>
      </component>

      <component id="detail-view" type="ui" color="teal">
        <label>Detail / action view</label>
        <description>Full content of the selected notification</description>
        <renders-based-on>
          <type value="weather_advisory">Renders advisory body with date range and location</type>
          <type value="feature_launch">Renders feature description with CTA button</type>
          <type value="maintenance">Renders maintenance window details</type>
          <type value="system_alert">Renders alert message with severity</type>
        </renders-based-on>
      </component>
    </layer>

    <event-types>
      <event type="weather_advisory" color="teal" geo-scoped="true"/>
      <event type="feature_launch" color="purple" geo-scoped="false"/>
      <event type="maintenance" color="coral" geo-scoped="false"/>
      <event type="system_alert" color="amber" geo-scoped="false"/>
    </event-types>

  </pipeline>

</system-design>